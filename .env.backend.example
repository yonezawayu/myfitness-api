# PostgreSQL container initialization administrator.
# These values are used only when PostgreSQL initializes an empty data directory.
# Existing installations must create a distinct administrator role before setting these values.
# Never copy the current application role here merely to bypass Compose validation.
POSTGRES_ADMIN_USER=replace_with_admin_role
POSTGRES_ADMIN_PASSWORD=replace_with_strong_admin_password

# Spring Boot application connection. Do not use the administrator role here.
MYFITNESS_DB_URL=jdbc:postgresql://localhost:5432/myfitness
MYFITNESS_DB_USERNAME=replace_with_application_role
MYFITNESS_DB_PASSWORD=replace_with_strong_application_password

# Use a sufficiently long, cryptographically random value.
MYFITNESS_JWT_SECRET=replace_with_random_jwt_signing_secret

# Manual Flyway execution. Use a dedicated migration role, not the application role.
FLYWAY_URL=jdbc:postgresql://localhost:5432/myfitness
FLYWAY_USER=replace_with_migration_role
FLYWAY_PASSWORD=replace_with_strong_migration_password
